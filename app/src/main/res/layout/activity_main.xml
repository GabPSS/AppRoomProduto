<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <EditText
        android:id="@+id/editProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nome do Produto" />
    <EditText
        android:id="@+id/editProductPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:hint="Preço" />
    <EditText
        android:id="@+id/editProductDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Descrição" />
    <EditText
        android:id="@+id/editProductQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantidade" />
    <Button
        android:id="@+id/btnInserirProduto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inserir Produto" />
    <Button
        android:id="@+id/btnListarProdutos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Listar Produtos" />

    <Button
        android:id="@+id/btnExcluir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Excluir todos"/>

    <EditText
        android:id="@+id/editSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Pesquisa" />

    <Button
        android:id="@+id/btnPesquisar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pesquisar"/>

    <EditText
        android:id="@+id/editAtualizarId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ID do produto" />

    <EditText
        android:id="@+id/editAtualizarPreco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Preço a ser alterado" />

    <Button
        android:id="@+id/btnAtualizar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Atualizar Preço"/>

    <TextView
        android:id="@+id/txvProdutos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />



</LinearLayout>